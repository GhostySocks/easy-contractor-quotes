# Public — safe to ship in the client bundle
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Dev-only: skip the paywall + RevenueCat for local Expo Go testing. Honored
# only when __DEV__ is true (production builds ignore this).
EXPO_PUBLIC_DEV_BYPASS_PAYWALL=

# Server only — do NOT prefix with EXPO_PUBLIC_
# These live in Supabase Edge Function secrets, never in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
# Optional — falls back to "Easy Contractor Quotes <no-reply@easycontractorquotes.com>".
# Must be a Resend-verified domain.
RESEND_FROM_EMAIL=
# Optional — override the URL the customer signing link points to. Defaults
# to the same Supabase functions origin as the caller.
CUSTOMER_SIGN_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
REVENUECAT_WEBHOOK_SECRET=
