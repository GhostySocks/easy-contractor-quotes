# Public — safe to ship in the client bundle
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Dev/tester-only: skip the paywall + RevenueCat. Honored only when __DEV__ is
# true or EXPO_PUBLIC_APP_VARIANT=internal (store builds ignore it).
EXPO_PUBLIC_DEV_BYPASS_PAYWALL=
# Set by eas.json per build profile — leave blank locally. 'internal' marks a
# tester APK shared by link; store builds leave it unset.
EXPO_PUBLIC_APP_VARIANT=

# Server only — do NOT prefix with EXPO_PUBLIC_
# These live in Supabase Edge Function secrets, never in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Dev-only: when 'true', edge functions skip the subscriptions.status check
# and accept any authenticated user. Set in Supabase edge function secrets
# only — NEVER prefix with EXPO_PUBLIC_. Unset before deploying to prod.
DEV_BYPASS_ENTITLEMENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
# Optional — falls back to "Easy Contractor Quotes <no-reply@easycontractorquotes.com>".
# Must be a Resend-verified domain.
RESEND_FROM_EMAIL=
# Optional — override the URL the customer signing link points to. Defaults
# to the same Supabase functions origin as the caller.
CUSTOMER_SIGN_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
REVENUECAT_WEBHOOK_SECRET=
