{
  "expo": {
    "name": "Easy Contractor Quotes",
    "slug": "easy-contractor-quotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easycontractorquotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.inexile.easycontractorquotes"
    },
    "android": {
      "package": "co.inexile.easycontractorquotes",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Easy Contractor Quotes uses the microphone when you tap \"Talk instead of type\" to describe a job.",
          "speechRecognitionPermission": "Easy Contractor Quotes turns what you say into text for the job description.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4AF37"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Easy Contractor Quotes uses your location only when you tap \"use my location\" to fill in a job address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Easy Contractor Quotes uses your photos so you can attach pictures of a job to its quote.",
          "cameraPermission": "Easy Contractor Quotes uses the camera so you can photograph a job for its quote.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3840b799-ce94-4ad6-a9ac-f7e28105a143"
      }
    },
    "owner": "ghostysocks"
  }
}
